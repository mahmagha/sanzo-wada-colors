{
  "name": "sanzo-wada-color-dictionary",
  "version": "1.0.0",
  "description": "Interactive viewer for Sanzo Wada's A Dictionary of Color Combinations (1933)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "tsc -p tsconfig.test.json --noEmit && jiti tests/all.test.ts",
    "test:e2e": "node tests/e2e.mjs",
    "prepare-data": "node scripts/build-all-data.mjs"
  },
  "keywords": [
    "sanzo-wada",
    "color-combinations",
    "color-dictionary",
    "japanese-palette",
    "color-harmony"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.78.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
